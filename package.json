{
  "name": "sanabil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sanabil Flour Distribution Manager",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "e2e": "node tests/e2e.mjs",
    "verify": "npm run check && npm test && npm run build",
    "qa": "npm run verify",
    "build:web": "node scripts/prepare-android-web.cjs",
    "build:android": "npm run build:web && cap sync android"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "playwright": "^1.64.1"
  }
}
